LLM_PROVIDER=nvidia_nim
NVIDIA_NIM_API_KEY=replace_with_your_nvidia_nim_api_key
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1.5
NVIDIA_NIM_TIMEOUT_S=30
NVIDIA_NIM_MAX_RETRIES=1
NVIDIA_NIM_MAX_TOKENS=256
NVIDIA_NIM_TEMPERATURE=0
NVIDIA_NIM_TOP_P=1

# Official LBNL EnergyPlus MCP server. Never put real tokens in this file.
ENERGYPLUS_MCP_ENABLED=false
ENERGYPLUS_MCP_URL=http://127.0.0.1:8000/mcp
ENERGYPLUS_MCP_TOKEN=replace_with_a_distinct_random_token_at_least_32_characters
ENERGYPLUS_MCP_TIMEOUT_S=180
ENERGYPLUS_MCP_WORKSPACE_ROOT=replace_with_absolute_simulation_workspace_path
# Set to /workspace/simulation_workspace when the MCP server runs in Docker.
ENERGYPLUS_MCP_SERVER_WORKSPACE_ROOT=replace_with_server_visible_workspace_path
ENERGYPLUS_MCP_EXPECTED_VERSION=26.1.0
ENERGYPLUS_SIMULATION_TIMEOUT_S=600
